<?xml version="1.0" encoding="utf-8"?>
<!-- item_chat_message_sent.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="60dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Message Container -->
    <LinearLayout
        android:id="@+id/ll_message_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="20dp"
        android:background="@drawable/message_sent_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Message Text -->
        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_on_primary"
            android:textColorLink="@color/aqua_accent"
            android:textSize="16sp"
            android:text="This is a sample sent message from customer to AquaLife store!" />

        <!-- Message Info Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Message Time -->
            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="sans-serif"
                android:text="2:30 PM"
                android:textColor="@color/text_on_primary"
                android:textSize="11sp"
                android:alpha="0.7" />

            <!-- Message Status Icon -->
            <ImageView
                android:id="@+id/iv_message_status"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_check_double"
                android:alpha="0.8"
                app:tint="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <!-- Message Status Text (for failed messages) -->
    <TextView
        android:id="@+id/tv_message_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_message_container"
        android:layout_alignEnd="@id/ll_message_container"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="Failed to send • Tap to retry"
        android:textColor="@color/error_red"
        android:textSize="11sp"
        android:visibility="gone" />

</RelativeLayout>
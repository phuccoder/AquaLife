<?xml version="1.0" encoding="utf-8"?>
<!-- item_chat_message_received.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="60dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Store Avatar -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_store_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_alignBottom="@id/ll_message_container"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/logo"
        app:civ_border_color="@color/aqua_accent"
        app:civ_border_width="1dp" />

    <!-- Message Container -->
    <LinearLayout
        android:id="@+id/ll_message_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/iv_store_avatar"
        android:layout_marginEnd="20dp"
        android:background="@drawable/message_received_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Store Name (for group chats) -->
        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="AquaLife Store"
            android:textColor="@color/aqua_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Message Text -->
        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_primary"
            android:textColorLink="@color/ocean_blue"
            android:textSize="16sp"
            android:text="Hello! Welcome to AquaLife! 🐠 How can I help you find the perfect aquatic companions today?" />

        <!-- Message Time -->
        <TextView
            android:id="@+id/tv_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:fontFamily="sans-serif"
            android:text="2:29 PM"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:alpha="0.7" />

    </LinearLayout>

    <!-- Quick Replies (for store suggestions) -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/fl_quick_replies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_message_container"
        android:layout_alignStart="@id/ll_message_container"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:justifyContent="flex_start">

        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:text="🐠 Tropical Fish"
            app:chipBackgroundColor="@color/surface_background"
            app:chipCornerRadius="16dp"
            app:chipStrokeColor="@color/aqua_accent"
            app:chipStrokeWidth="1dp"
            app:textStartPadding="4dp"
            app:textEndPadding="4dp" />

        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:text="🪸 Coral Care"
            app:chipBackgroundColor="@color/surface_background"
            app:chipCornerRadius="16dp"
            app:chipStrokeColor="@color/aqua_accent"
            app:chipStrokeWidth="1dp"
            app:textStartPadding="4dp"
            app:textEndPadding="4dp" />

        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:text="🏺 Aquarium Setup"
            app:chipBackgroundColor="@color/surface_background"
            app:chipCornerRadius="16dp"
            app:chipStrokeColor="@color/aqua_accent"
            app:chipStrokeWidth="1dp"
            app:textStartPadding="4dp"
            app:textEndPadding="4dp" />

    </com.google.android.flexbox.FlexboxLayout>

</RelativeLayout>